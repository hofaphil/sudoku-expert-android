<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dim">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dim"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            android:background="@color/surface_dim"
            app:contentScrim="@color/surface_dim"
            app:expandedTitleMarginStart="24dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:title="@string/settings_title">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_back"
                app:navigationIconTint="@color/on_surface" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/gameSettings"
                style="@style/Settings.Header"
                android:text="@string/settings_title_game_settings" />

            <LinearLayout
                android:id="@+id/markNumbers"
                style="@style/Settings.Row.Static"
                android:background="@drawable/settings_row_top">

                <LinearLayout style="@style/Settings.Row.Text">

                    <TextView
                        style="@style/Settings.Row.Title"
                        android:text="@string/settings_markNumbers" />

                    <TextView
                        style="@style/Settings.Row.Summary"
                        android:text="@string/settings_markNumbersAnnotations" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/markNumbersSwitch"
                    style="@style/Settings.Row.Switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/markLines"
                style="@style/Settings.Row.Static"
                android:background="@drawable/settings_row_middle">

                <LinearLayout style="@style/Settings.Row.Text">

                    <TextView
                        style="@style/Settings.Row.Title"
                        android:text="@string/settings_markLines" />

                    <TextView
                        style="@style/Settings.Row.Summary"
                        android:text="@string/settings_markLinesAnnotations" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/markLinesSwitch"
                    style="@style/Settings.Row.Switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/checkNotes"
                style="@style/Settings.Row.Static"
                android:background="@drawable/settings_row_middle">

                <LinearLayout style="@style/Settings.Row.Text">

                    <TextView
                        style="@style/Settings.Row.Title"
                        android:text="@string/settings_checkNotes" />

                    <TextView
                        style="@style/Settings.Row.Summary"
                        android:text="@string/settings_checkNotesAnnotations" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/checkNotesSwitch"
                    style="@style/Settings.Row.Switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hideCompleted"
                style="@style/Settings.Row.Static"
                android:background="@drawable/settings_row_middle">

                <LinearLayout style="@style/Settings.Row.Text">

                    <TextView
                        style="@style/Settings.Row.Title"
                        android:text="@string/settings_hideCompleted" />

                    <TextView
                        style="@style/Settings.Row.Summary"
                        android:text="@string/settings_hideCompletedAnnotations" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/hideCompletedSwitch"
                    style="@style/Settings.Row.Switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/showErrors"
                style="@style/Settings.Row.Static"
                android:background="@drawable/settings_row_middle">

                <LinearLayout style="@style/Settings.Row.Text">

                    <TextView
                        style="@style/Settings.Row.Title"
                        android:text="@string/settings_showErrors" />

                    <TextView
                        style="@style/Settings.Row.Summary"
                        android:text="@string/settings_showErrorsAnnotations" />

                    <TextView
                        style="@style/Settings.Row.Note"
                        android:text="@string/settings_applies_next_game" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/showErrorsSwitch"
                    style="@style/Settings.Row.Switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/showTime"
                style="@style/Settings.Row.Static"
                android:background="@drawable/settings_row_bottom">

                <LinearLayout style="@style/Settings.Row.Text">

                    <TextView
                        style="@style/Settings.Row.Title"
                        android:text="@string/settings_showTime" />

                    <TextView
                        style="@style/Settings.Row.Summary"
                        android:text="@string/settings_showTimeAnnotations" />

                    <TextView
                        style="@style/Settings.Row.Note"
                        android:text="@string/settings_applies_next_game" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/showTimeSwitch"
                    style="@style/Settings.Row.Switch" />
            </LinearLayout>

            <TextView
                android:id="@+id/more"
                style="@style/Settings.Header"
                android:text="@string/settings_title_more" />

            <LinearLayout
                android:id="@+id/deleteData"
                style="@style/Settings.Row"
                android:background="@drawable/settings_row_top">

                <LinearLayout style="@style/Settings.Row.Text">

                    <TextView
                        style="@style/Settings.Row.Title"
                        android:text="@string/settings_deleteData" />

                    <TextView
                        style="@style/Settings.Row.Summary"
                        android:text="@string/settings_deleteDataAnnotations" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info"
                style="@style/Settings.Row"
                android:background="@drawable/settings_row_bottom">

                <LinearLayout style="@style/Settings.Row.Text">

                    <TextView
                        style="@style/Settings.Row.Title"
                        android:text="@string/settings_about" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
