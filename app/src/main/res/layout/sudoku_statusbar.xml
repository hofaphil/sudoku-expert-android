<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/top_bar"
    android:paddingHorizontal="@dimen/edgeSpacing"
    android:paddingBottom="13dp">

    <!-- square buttons left and right, difficulty above the timer in the middle -->
    <RelativeLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Box.Icon"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/difficultyView"
                style="@style/Text.Label"
                android:text="@string/advanced"
                android:textColor="@color/on_top_bar" />

            <TextView
                android:id="@+id/timeView"
                style="@style/Text.TopBar"
                android:text="00:00"
                android:textSize="@dimen/statusbar_text_time" />
        </LinearLayout>
    </RelativeLayout>

    <!-- progress of the filled fields and the lives left -->
    <com.aol.philipphofer.gui.GameProgress
        android:id="@+id/gameProgress"
        style="@style/GameProgress"
        android:layout_below="@id/buttonLayout" />
</RelativeLayout>
