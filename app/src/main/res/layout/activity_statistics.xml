<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/edgeSpacing"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/beginnerTitle"
                style="@style/Settings.Header"
                android:text="@string/beginner" />

            <LinearLayout style="@style/Settings.Group">

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        android:id="@+id/Beginner.Average"
                        style="@style/Settings.Row.Name"
                        android:text="@string/statistics_average" />

                    <TextView
                        android:id="@+id/Beginner.Average.Time"
                        style="@style/Settings.Row.Value"
                        android:text="00:00" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        android:id="@+id/Beginner.Best"
                        style="@style/Settings.Row.Name"
                        android:text="@string/statistics_best" />

                    <TextView
                        android:id="@+id/Beginner.Best.Time"
                        style="@style/Settings.Row.Value"
                        android:text="00:00" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        android:id="@+id/Beginner.TimesPlayed"
                        style="@style/Settings.Row.Name"
                        android:text="@string/statistics_times_played" />

                    <TextView
                        android:id="@+id/Beginner.TimesPlayed.Count"
                        style="@style/Settings.Row.Value"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/advancedTitle"
                style="@style/Settings.Header"
                android:text="@string/advanced" />

            <LinearLayout style="@style/Settings.Group">

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        android:id="@+id/Advanced.Average"
                        style="@style/Settings.Row.Name"
                        android:text="@string/statistics_average" />

                    <TextView
                        android:id="@+id/Advanced.Average.Time"
                        style="@style/Settings.Row.Value"
                        android:text="00:00" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        android:id="@+id/Advanced.Best"
                        style="@style/Settings.Row.Name"
                        android:text="@string/statistics_best" />

                    <TextView
                        android:id="@+id/Advanced.Best.Time"
                        style="@style/Settings.Row.Value"
                        android:text="00:00" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        android:id="@+id/Advanced.TimesPlayed"
                        style="@style/Settings.Row.Name"
                        android:text="@string/statistics_times_played" />

                    <TextView
                        android:id="@+id/Advanced.TimesPlayed.Count"
                        style="@style/Settings.Row.Value"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/expertTitle"
                style="@style/Settings.Header"
                android:text="@string/expert" />

            <LinearLayout style="@style/Settings.Group">

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        android:id="@+id/Expert.Average"
                        style="@style/Settings.Row.Name"
                        android:text="@string/statistics_average" />

                    <TextView
                        android:id="@+id/Expert.Average.Time"
                        style="@style/Settings.Row.Value"
                        android:text="00:00" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        android:id="@+id/Expert.Best"
                        style="@style/Settings.Row.Name"
                        android:text="@string/statistics_best" />

                    <TextView
                        android:id="@+id/Expert.Best.Time"
                        style="@style/Settings.Row.Value"
                        android:text="00:00" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        android:id="@+id/Expert.TimesPlayed"
                        style="@style/Settings.Row.Name"
                        android:text="@string/statistics_times_played" />

                    <TextView
                        android:id="@+id/Expert.TimesPlayed.Count"
                        style="@style/Settings.Row.Value"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
