<?xml version="1.0" encoding="utf-8"?>
<!-- the padding keeps the box off the screen edge -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">

    <LinearLayout style="@style/Box">

        <include layout="@layout/dialog_header" />

        <!-- rows like in the statistics, with a line below the last one -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/divider"
            android:orientation="vertical"
            android:showDividers="middle|end">

            <LinearLayout style="@style/Settings.Row">

                <TextView
                    style="@style/Settings.Row.Name"
                    android:text="@string/endcard_time" />

                <TextView
                    android:id="@+id/timeInfo"
                    style="@style/Settings.Row.Value" />
            </LinearLayout>

            <LinearLayout style="@style/Settings.Row">

                <TextView
                    style="@style/Settings.Row.Name"
                    android:text="@string/endcard_besttime" />

                <TextView
                    android:id="@+id/bestTimeInfo"
                    style="@style/Settings.Row.Value" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Dialog.Buttons">

            <Button
                android:id="@+id/dialogOk"
                style="@style/Button.Box.Dialog.Primary"
                android:text="@string/confirmdialog_ok" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
