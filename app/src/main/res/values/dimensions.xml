<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- the digits in the fields and on the keys scale with the screen width, see SudokuField and Keyboard -->

    <!-- black borders of boxes, buttons and blocks -->
    <dimen name="border">2.5dp</dimen>
    <!-- thin lines between the cells and between setting rows -->
    <dimen name="line">1dp</dimen>

    <!-- gap between the 3x3 blocks and to the screen edge is twice this -->
    <dimen name="blockSpacing">4dp</dimen>
    <!-- space to the screen edge, same as the gap between the 3x3 blocks -->
    <dimen name="edgeSpacing">8dp</dimen>

    <!-- Keyboard -->
    <dimen name="keyboardFunctionalText">14sp</dimen>
    <dimen name="keyboardButtonSpacing">4dp</dimen>

    <!-- StatusBar -->
    <dimen name="statusbar_text_time">30sp</dimen>
    <dimen name="statusbar_text_info">14sp</dimen>
    <dimen name="statusbar_icon_size">26dp</dimen>
    <dimen name="statusbar_button_padding">12dp</dimen>
    <dimen name="statusbar_progress_height">16dp</dimen>
    <dimen name="statusbar_heart_size">20dp</dimen>
    <dimen name="statusbar_heart_spacing">4dp</dimen>
    <!-- box with the progress and the hearts, keeps its height when the hearts are hidden -->
    <dimen name="statusbar_info_height">40dp</dimen>

    <dimen name="text_label">12sp</dimen>

    <!-- Settings and Statistics -->
    <dimen name="header_text_title">26sp</dimen>
    <dimen name="settings_text_title">16sp</dimen>
    <dimen name="settings_text_summary">13sp</dimen>
    <!-- the thumb is a square of the switch height, its black part is inset by switch_thumb_inset -->
    <dimen name="switch_width">48dp</dimen>
    <dimen name="switch_height">24dp</dimen>
    <dimen name="switch_thumb_inset">5dp</dimen>

</resources>
