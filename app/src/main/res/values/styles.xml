<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Themes ============================================================ -->

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorAccent">@color/secondary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/top_bar</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <!-- same color as the top bar: yellow in light mode, dark in dark mode -->
    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/top_bar</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@color/top_bar</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">@color/top_bar</item>
        <!-- keep the icon on its yellow background, the dark icon lines would vanish on the dark splash -->
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/ic_launcher_background</item>
    </style>

    <!-- Text ============================================================== -->

    <!-- base of all texts, the font comes from the theme -->
    <style name="Text" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.Bold">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- small uppercase label: difficulty in the status bar, group titles -->
    <style name="Text.Label" parent="Text.Bold">
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <!-- timer, screen and dialog titles on the top bar -->
    <style name="Text.TopBar" parent="Text.Bold">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/on_top_bar</item>
        <item name="android:textSize">@dimen/header_text_title</item>
    </style>

    <!-- Boxes and lines =================================================== -->

    <!-- white box with a black border, the padding keeps the content inside the border -->
    <style name="Box" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/box_top_bar</item>
        <item name="android:padding">@dimen/border</item>
    </style>

    <!-- square icon in a box: new, more and back buttons, dialog icon -->
    <style name="Box.Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:padding">@dimen/statusbar_button_padding</item>
    </style>

    <!-- black line below the top bar and above the keyboard -->
    <style name="Line" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/border</item>
        <item name="android:background">@color/outline</item>
    </style>

    <!-- divides the parts of a card, e.g. the play section of the continue card -->
    <style name="Line.Vertical">
        <item name="android:layout_width">@dimen/border</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!-- thin like the lines between the setting rows, between the toolbar tabs -->
    <style name="Line.Vertical.Thin">
        <item name="android:layout_width">@dimen/line</item>
    </style>

    <!-- Buttons =========================================================== -->

    <style name="Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- number keys of the keyboard -->
    <style name="Button.Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@null</item>
    </style>

    <!-- button in a black bordered box -->
    <style name="Button.Box">
        <item name="android:foreground">@drawable/box</item>
        <item name="android:background">@color/key_background</item>
    </style>

    <!-- notes, delete and pause: icon above the text -->
    <style name="Button.Box.Function">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">@dimen/keyboardButtonSpacing</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">@dimen/border</item>
        <item name="android:drawableTint">@color/on_surface</item>
        <item name="android:textSize">@dimen/keyboardFunctionalText</item>
    </style>

    <!-- the dialog buttons share the width, their margins add up to the gap between them -->
    <style name="Button.Box.Dialog">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">5dp</item>
        <item name="android:textSize">@dimen/settings_text_title</item>
    </style>

    <!-- confirming button, yellow like the top bar -->
    <style name="Button.Box.Dialog.Primary">
        <item name="android:background">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <!-- Settings and statistics: groups of rows in a box ================== -->

    <!-- purple badge above a group -->
    <style name="Settings.Header" parent="Text.Label">
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/badge</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@color/on_secondary</item>
    </style>

    <style name="Settings.Group" parent="Box">
        <item name="android:divider">@drawable/divider</item>
        <item name="android:showDividers">middle</item>
    </style>

    <style name="Settings.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">13dp</item>
    </style>

    <!-- title above wide content, e.g. the heat map -->
    <style name="Settings.Row.Vertical">
        <item name="android:gravity">start</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Settings.Row.Clickable">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- title and summary of a setting, fills the row up to the switch -->
    <style name="Settings.Row.Text" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Settings.Row.Title" parent="Text.Bold">
        <item name="android:textSize">@dimen/settings_text_title</item>
    </style>

    <style name="Settings.Row.Summary" parent="Text">
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/settings_text_summary</item>
    </style>

    <!-- name and value of a statistic -->
    <style name="Settings.Row.Name" parent="Settings.Row.Title">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Settings.Row.Value" parent="Settings.Row.Title">
        <item name="android:layout_marginStart">13dp</item>
    </style>

    <style name="Settings.Row.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">13dp</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="track">@drawable/switch_track</item>
        <item name="switchMinWidth">@dimen/switch_width</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
    </style>

    <!-- Dialogs =========================================================== -->

    <style name="Dialog.Message" parent="Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:padding">18dp</item>
        <item name="android:textSize">@dimen/settings_text_title</item>
    </style>

    <!-- the button margins fill up the padding to the box edge -->
    <style name="Dialog.Buttons" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">13dp</item>
        <item name="android:paddingVertical">18dp</item>
    </style>

    <!-- bordered box with the progress bar and the hearts, see GameProgress -->
    <style name="GameProgress" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/box_top_bar</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/statusbar_info_height</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Home ============================================================== -->

    <!-- bordered card on the home screen, the whole card is the button -->
    <style name="Home.Card" parent="Box">
        <item name="android:layout_marginTop">@dimen/home_card_spacing</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Home.Card.Title" parent="Text.Bold">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">@dimen/home_card_title_text</item>
    </style>

    <!-- tab of the bottom toolbar: icon above the label, yellow while selected -->
    <style name="Home.Tab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:background">@drawable/tab_background</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Home.Tab.Icon" parent="">
        <item name="android:layout_width">@dimen/home_tab_icon_size</item>
        <item name="android:layout_height">@dimen/home_tab_icon_size</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- takes the selected state of the tab for its color -->
    <style name="Home.Tab.Text" parent="Text.Bold">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:textSize">@dimen/home_tab_text</item>
    </style>

    <!-- purple badge above the cards like the settings groups, the cards bring their own top margin -->
    <style name="Home.Header" parent="Settings.Header">
        <item name="android:layout_marginBottom">0dp</item>
    </style>

    <!-- Statistics ======================================================== -->

    <!-- difficulty tab above the statistics, yellow while selected like the toolbar tabs -->
    <style name="Statistics.Tab" parent="Text.Bold">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/tab_background</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:textSize">@dimen/home_tab_text</item>
    </style>

    <!-- Result ============================================================ -->

    <!-- bordered tile with a small label above a big value, replaces the box padding -->
    <style name="Result.Tile" parent="Box">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Result.Tile.Label" parent="Text">
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/settings_text_summary</item>
    </style>

    <style name="Result.Tile.Value" parent="Text.Bold">
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">@dimen/result_value_text</item>
    </style>

    <!-- bordered button, the bottom row shares the width -->
    <style name="Result.Button" parent="Button.Box">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/result_button_height</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textSize">@dimen/settings_text_title</item>
    </style>

    <!-- full width yellow button: play again -->
    <style name="Result.Button.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_weight">0</item>
        <item name="android:background">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">@dimen/result_button_text</item>
    </style>

    <!-- Fields ============================================================ -->

    <style name="Field" parent="">
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="Field.Number">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textColor">@color/number_given</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- one of the 3x3 notes of a field -->
    <style name="Field.Note">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:visibility">invisible</item>
    </style>
</resources>
