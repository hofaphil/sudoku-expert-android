<?xml version="1.0" encoding="utf-8"?>
<!-- the borders get the width of the hearts outline in StatusBar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/top_bar_box" />
            <stroke
                android:width="@dimen/line"
                android:color="@color/outline" />
        </shape>
    </item>

    <!-- scaled instead of clipped, so the fill keeps its border on the right -->
    <item android:id="@android:id/progress">
        <scale
            android:scaleGravity="start|fill_vertical"
            android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <solid android:color="@color/secondary_fill" />
                <stroke
                    android:width="@dimen/line"
                    android:color="@color/outline" />
            </shape>
        </scale>
    </item>

</layer-list>
