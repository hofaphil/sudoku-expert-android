<?xml version="1.0" encoding="utf-8"?>
<!-- lines between the cells show through the fields margins, the stroke frames the 3x3 block -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle" >

    <solid android:color="@color/grid_line" />

    <stroke
        android:width="@dimen/border"
        android:color="@color/grid_border" />

</shape>
